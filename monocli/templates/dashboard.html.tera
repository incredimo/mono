<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Device Dashboard - {{ device_name }} - {{ timestamp }}</title>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; margin: 0; padding: 0; background-color: #f4f4f4; }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        h1, h2 { color: #2c3e50; }
        .dashboard { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
        .card { background-color: #fff; border-radius: 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); padding: 20px; }
        .chart { width: 100%; height: 300px; } /* Ensure charts have a defined height */
        table { border-collapse: collapse; width: 100%; margin-top: 10px; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
        .collapsible { background-color: #777; color: white; cursor: pointer; padding: 18px; width: 100%; border: none; text-align: left; outline: none; font-size: 15px; margin-top: 10px; }
        .active, .collapsible:hover { background-color: #555; }
        .content { padding: 0 18px; max-height: 0; overflow: hidden; transition: max-height 0.2s ease-out; background-color: #f1f1f1; }
        #searchInput { width: 100%; font-size: 16px; padding: 12px 20px 12px 40px; border: 1px solid #ddd; margin-bottom: 12px; box-sizing: border-box; }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.1/moment.min.js"></script>
</head>
<body>
    <div class="container">
        <h1>Device Dashboard - {{ device_name }}</h1>
        <p>Generated on: {{ timestamp }}</p>

        <div class="card">
            <h2>Quick Stats</h2>
            <ul>
                <li>Model: {{ quick_stats.model | default(value="N/A") }}</li>
                <li>Android Version: {{ quick_stats.android_version | default(value="N/A") }}</li>
                <li>Total RAM: {{ quick_stats.total_ram | default(value="N/A") }} KB</li>
                <li>Total Storage: {{ quick_stats.total_storage | default(value="N/A") }} KB</li>
            </ul>
        </div>

        <div class="dashboard">
            <div class="card">
                <h2>Storage Usage</h2>
                <div class="chart"><canvas id="storageChart"></canvas></div>
            </div>
            <div class="card">
                <h2>Battery Status</h2>
                <div class="chart"><canvas id="batteryChart"></canvas></div>
            </div>
            <div class="card">
                <h2>Memory Usage</h2>
                <div class="chart"><canvas id="memoryChart"></canvas></div>
            </div>
            <div class="card">
                <h2>CPU Usage</h2>
                <div class="chart"><canvas id="cpuChart"></canvas></div>
            </div>
            <div class="card">
                <h2>Network Usage</h2>
                <div class="chart"><canvas id="networkChart"></canvas></div>
            </div>
        </div>

        <h2>Detailed Information</h2>
        <input type="text" id="searchInput" onkeyup="searchTables()" placeholder="Search for information...">

        {% for section in detailed_sections %}
        <button class="collapsible">{{ section.title }}</button>
        <div class="content">
            <table>
                <thead>
                    <tr><th>Property</th><th>Value</th></tr>
                </thead>
                <tbody>
                {% for item in section.data %}
                <tr><td>{{ item.key }}</td><td>{{ item.value }}</td></tr>
                {% else %}
                <tr><td colspan="2">No data available for this section.</td></tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% endfor %}
    </div>

    <script>
        // Collapsible script
        var coll = document.getElementsByClassName("collapsible");
        for (var i = 0; i < coll.length; i++) {
            coll[i].addEventListener("click", function() {
                this.classList.toggle("active");
                var content = this.nextElementSibling;
                if (content.style.maxHeight){
                    content.style.maxHeight = null;
                } else {
                    content.style.maxHeight = content.scrollHeight + "px";
                }
            });
        }

        // Search script
        function searchTables() {
            var input, filter, tables, tr, td, i, j, k, txtValue;
            input = document.getElementById("searchInput");
            filter = input.value.toUpperCase();
            var contentSections = document.getElementsByClassName("content");

            for (i = 0; i < contentSections.length; i++) {
                var anyRowMatches = false;
                tables = contentSections[i].getElementsByTagName("table");
                for (j = 0; j < tables.length; j++) {
                    tr = tables[j].getElementsByTagName("tr");
                    for (k = 1; k < tr.length; k++) { // Start from k=1 to skip header row
                        td = tr[k].getElementsByTagName("td");
                        var rowMatch = false;
                        for (var l = 0; l < td.length; l++) {
                            if (td[l]) {
                                txtValue = td[l].textContent || td[l].innerText;
                                if (txtValue.toUpperCase().indexOf(filter) > -1) {
                                    rowMatch = true;
                                    anyRowMatches = true;
                                    break;
                                }
                            }
                        }
                        if(rowMatch) {
                            tr[k].style.display = "";
                        } else {
                            tr[k].style.display = "none";
                        }
                    }
                }
                // Expand section if it has matching content
                var collapsibleButton = contentSections[i].previousElementSibling;
                if (anyRowMatches && !collapsibleButton.classList.contains("active")) {
                     if (contentSections[i].style.maxHeight){
                        // already open or being handled, do nothing or ensure it's open
                     } else {
                        collapsibleButton.classList.add("active");
                        contentSections[i].style.maxHeight = contentSections[i].scrollHeight + "px";
                     }
                }
            }
        }

        // Chart.js initializations
        new Chart(document.getElementById('storageChart').getContext('2d'), {
            type: 'doughnut',
            data: {{ storage_chart_data | safe }},
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'top' }, title: { display: true, text: 'Storage Usage' } } }
        });
        new Chart(document.getElementById('batteryChart').getContext('2d'), {
            type: 'doughnut',
            data: {{ battery_chart_data | safe }},
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'top' }, title: { display: true, text: 'Battery Status' } } }
        });
        new Chart(document.getElementById('memoryChart').getContext('2d'), {
            type: 'doughnut',
            data: {{ memory_chart_data | safe }},
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'top' }, title: { display: true, text: 'Memory Usage' } } }
        });
         new Chart(document.getElementById('cpuChart').getContext('2d'), {
            type: 'doughnut',
            data: {{ cpu_chart_data | safe }},
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'top' }, title: { display: true, text: 'CPU Usage' } } }
        });
        new Chart(document.getElementById('networkChart').getContext('2d'), {
            type: 'line', // Assuming network chart is line
            data: {{ network_chart_data | safe }},
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'top' }, title: { display: true, text: 'Network Usage' } }, scales: { x: { type: 'time', time: { unit: 'minute' } }, y: { beginAtZero: true } } }
        });
    </script>
</body>
</html>
